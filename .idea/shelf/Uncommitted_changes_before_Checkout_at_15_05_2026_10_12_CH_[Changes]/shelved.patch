<+>import * as Phaser from 'phaser';\n\nconst DEFAULT_SEGMENT_SIZE = 48;\nconst DEFAULT_SEGMENT_SPREAD = 1;\nconst DEFAULT_DAMAGE_SHAPE = 'circle';\n\nfunction snapRadiusToGrid(radius, segmentSize) {\n    return Math.max(segmentSize, Math.round(radius / segmentSize) * segmentSize);\n}\n\nfunction drawDamageShapePath(context, centerX, centerY, radius, shape = DEFAULT_DAMAGE_SHAPE) {\n    context.beginPath();\n\n    if (shape === 'ellipse') {\n        const ellipseRadiusX = radius * 1.2;\n        const ellipseRadiusY = radius * 0.8;\n        context.ellipse(centerX, centerY, ellipseRadiusX, ellipseRadiusY, 0, 0, Math.PI * 2);\n        return;\n    }\n\n    context.arc(centerX, centerY, radius, 0, Math.PI * 2);\n}\n\nexport function createDestructibleLayer(scene, sourceKey, canvasKey, depth) {\n    const sourceImage = scene.textures.get(sourceKey).getSourceImage();\n    const texture = scene.textures.createCanvas(canvasKey, sourceImage.width, sourceImage.height);\n    const context = texture.getContext();\n\n    context.clearRect(0, 0, sourceImage.width, sourceImage.height);\n    context.drawImage(sourceImage, 0, 0);\n    texture.refresh();\n\n    const image = scene.add.image(0, 0, canvasKey).setOrigin(0, 0).setDepth(depth);\n\n    return {\n        sourceWidth: sourceImage.width,\n        sourceHeight: sourceImage.height,\n        texture,\n        context,\n        image,\n    };\n}\n\nexport function resizeDestructibleLayer(layer, width, height) {\n    layer.image.setDisplaySize(width, height);\n}\n\nexport function damageDestructibleLayer(\n    layer,\n    screenX,\n    screenY,\n    screenWidth,\n    screenHeight,\n    radius,\n    segmentSize = DEFAULT_SEGMENT_SIZE,\n    shape = DEFAULT_DAMAGE_SHAPE\n) {\n    const centerX = Phaser.Math.Clamp(Math.floor((screenX / screenWidth) * layer.sourceWidth), 0, layer.sourceWidth - 1);\n    const centerY = Phaser.Math.Clamp(Math.floor((screenY / screenHeight) * layer.sourceHeight), 0, layer.sourceHeight - 1);\n    const rawTextureRadius = radius * ((layer.sourceWidth / screenWidth + layer.sourceHeight / screenHeight) / 2);\n    const textureRadius = snapRadiusToGrid(rawTextureRadius, segmentSize);\n    const segmentSpread = Math.max(DEFAULT_SEGMENT_SPREAD, Math.ceil(textureRadius / segmentSize));\n    const segmentX = Math.floor(centerX / segmentSize);\n    const segmentY = Math.floor(centerY / segmentSize);\n\n    layer.context.save();\n    drawDamageShapePath(layer.context, centerX, centerY, textureRadius, shape);\n    layer.context.clip();\n    layer.context.globalCompositeOperation = 'destination-out';\n\n    for (let y = segmentY - segmentSpread; y <= segmentY + segmentSpread; y += 1) {\n        for (let x = segmentX - segmentSpread; x <= segmentX + segmentSpread; x += 1) {\n            layer.context.fillRect(\n                x * segmentSize,\n                y * segmentSize,\n                segmentSize,\n                segmentSize\n            );\n        }\n    }\n\n    layer.context.restore();\n    layer.texture.refresh();\n}\n\nexport function damageDestructibleLayers(\n    layers,\n    screenX,\n    screenY,\n    screenWidth,\n    screenHeight,\n    radius,\n    shape = DEFAULT_DAMAGE_SHAPE\n) {\n    for (const layer of layers) {\n        damageDestructibleLayer(layer, screenX, screenY, screenWidth, screenHeight, radius, DEFAULT_SEGMENT_SIZE, shape);\n    }\n}\n\n\nexport function collapseUnsupportedPixels(layer, alphaThreshold = 20) {\n    const width = layer.sourceWidth;\n    const height = layer.sourceHeight;\n    const imageData = layer.context.getImageData(0, 0, width, height);\n    const data = imageData.data;\n    const supported = new Uint8Array(width * height);\n    const stack = [];\n\n    const isVisible = (index) => data[(index * 4) + 3] > alphaThreshold;\n    const addSupported = (index) => {\n        if (!supported[index] && isVisible(index)) {\n            supported[index] = 1;\n            stack.push(index);\n        }\n    };\n\n    // Pixels touching the bottom of the layer are grounded. Every visible\n    // component connected to ground survives; floating islands fall away.\n    for (let x = 0; x < width; x += 1) {\n        addSupported(((height - 1) * width) + x);\n    }\n\n    while (stack.length) {\n        const index = stack.pop();\n        const x = index % width;\n        const y = Math.floor(index / width);\n\n        if (x > 0) addSupported(index - 1);\n        if (x < width - 1) addSupported(index + 1);\n        if (y > 0) addSupported(index - width);\n        if (y < height - 1) addSupported(index + width);\n    }\n\n    let removed = 0;\n    for (let index = 0; index < supported.length; index += 1) {\n        if (isVisible(index) && !supported[index]) {\n            data[(index * 4) + 3] = 0;\n            removed += 1;\n        }\n    }\n\n    if (removed > 0) {\n        layer.context.putImageData(imageData, 0, 0);\n        layer.texture.refresh();\n    }\n\n    return removed;\n}\n\nexport function getVisiblePixelRatio(layer, sampleStep = 6) {\n    let visible = 0;\n    let total = 0;\n\n    for (let y = 0; y < layer.sourceHeight; y += sampleStep) {\n        for (let x = 0; x < layer.sourceWidth; x += sampleStep) {\n            const alpha = layer.context.getImageData(x, y, 1, 1).data[3];\n            if (alpha > 20) visible += 1;\n            total += 1;\n        }\n    }\n\n    return total === 0 ? 0 : visible / total;\n}\n\n\nexport function getVisiblePixelCount(layer, sampleStep = 4) {\n    let visible = 0;\n\n    for (let y = 0; y < layer.sourceHeight; y += sampleStep) {\n        for (let x = 0; x < layer.sourceWidth; x += sampleStep) {\n            const alpha = layer.context.getImageData(x, y, 1, 1).data[3];\n            if (alpha > 20) visible += 1;\n        }\n    }\n\n    return visible;\n}\n\nfunction getTexturePoint(layer, screenX, screenY, screenWidth, screenHeight) {\n    return {\n        x: Phaser.Math.Clamp(Math.floor((screenX / screenWidth) * layer.sourceWidth), 0, layer.sourceWidth - 1),\n        y: Phaser.Math.Clamp(Math.floor((screenY / screenHeight) * layer.sourceHeight), 0, layer.sourceHeight - 1),\n    };\n}\n\nexport function hasVisiblePixelAt(layer, screenX, screenY, screenWidth, screenHeight, alphaThreshold = 20) {\n    const point = getTexturePoint(layer, screenX, screenY, screenWidth, screenHeight);\n    return layer.context.getImageData(point.x, point.y, 1, 1).data[3] > alphaThreshold;\n}\n\nexport function findTopVisiblePixelAtScreenX(layer, screenX, screenWidth, screenHeight, step = 2, alphaThreshold = 20) {\n    const textureX = Phaser.Math.Clamp(Math.floor((screenX / screenWidth) * layer.sourceWidth), 0, layer.sourceWidth - 1);\n\n    for (let textureY = 0; textureY < layer.sourceHeight; textureY += step) {\n        const alpha = layer.context.getImageData(textureX, textureY, 1, 1).data[3];\n        if (alpha > alphaThreshold) {\n            return {\n                x: screenX,\n                y: (textureY / layer.sourceHeight) * screenHeight,\n            };\n        }\n    }\n\n    return null;\n}\n\nexport function findRandomTopImpactPoint(layer, screenWidth, screenHeight, attempts = 200) {\n    for (let i = 0; i < attempts; i += 1) {\n        const textureX = Phaser.Math.Between(0, layer.sourceWidth - 1);\n\n        for (let textureY = 0; textureY < layer.sourceHeight; textureY += 2) {\n            const alpha = layer.context.getImageData(textureX, textureY, 1, 1).data[3];\n            if (alpha > 20) {\n                return {\n                    x: (textureX / layer.sourceWidth) * screenWidth,\n                    y: (textureY / layer.sourceHeight) * screenHeight,\n                };\n            }\n        }\n    }\n\n    return null;\n}\n
